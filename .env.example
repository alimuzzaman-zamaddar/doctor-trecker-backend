# ---------------------------------------------------------------------------
# Doctor Tracker - backend environment variables
# Copy this file to .env and replace every placeholder with your own values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Port the Express server listens on.
PORT=5000

# "development" or "production". In production cookies are sent as secure.
NODE_ENV=development

# MongoDB Atlas connection string.
# Replace <username>, <password> and doctor-tracker with your own values.
# If your password contains special characters, URL-encode them first.
# Provided connection strings:
# 1. mongosh via zlib: mongodb+srv://doctor-tracker:doctortracker@cluster0.mubdbyg.mongodb.net/?compressors=zlib
# 2. Node driver via replica set with SSL: mongodb://doctor-tracker:doctortracker@ac-sjnxgel-shard-00-00.mubdbyg.mongodb.net:27017,ac-sjnxgel-shard-00-01.mubdbyg.mongodb.net:27017,ac-sjnxgel-shard-00-02.mubdbyg.mongodb.net:27017/?ssl=true&replicaSet=atlas-dtxlqh-shard-0&authSource=admin
MONGO_URI=mongodb+srv://doctor-tracker:doctortracker@cluster0.mubdbyg.mongodb.net/doctor-tracker?retryWrites=true&w=majority&appName=Cluster0

# Secret used to sign JWTs. Use a long random string (for example 64+ chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret

# How long a login session stays valid.
JWT_EXPIRES_IN=7d

# The frontend origin allowed to call this API (comma-separate multiple origins).
CLIENT_URL=http://localhost:3000

# Default admin account created by "npm run seed:admin".
# Choose a strong password with at least 8 characters.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
